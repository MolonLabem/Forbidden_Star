  "combatText": [
    [
      {
        "title": "Прорвать Строй",
        "general": "",
        "unit": "Воин/Жнец: Получите 1 [M].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/s1.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BB"
      },
      {
        "title": "Фаланга",
        "general": "",
        "unit": "Воин/Жнец: Получите 1 [M].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/s2.jpg",
        "aspect": 0.7194928684627575,
        "icons": "SS"
      },
      {
        "title": "Криптек",
        "general": "Получите 1 [B], 1 [S] или 1 [M]. *newline* Потратьте 1 [M], чтобы выбрать: забрать 1 ваш отряд из этого мира и разместить его деморализованным в любом дружественном мире, который содержит постройку; забрать 1 ваш отряд с командным уровнем 0-1 из любого мира, который содержит постройку, и разместить его в этом мире.",
        "unit": "",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/s3.jpg",
        "aspect": 0.7194928684627575,
        "icons": "M"
      },
      {
        "title": "Освежеванные",
        "general": "Получите 2 (B).",
        "unit": "Воин/Жнец: Если у вашего противника есть хотя бы 1 [M], то вынудите его потерять 1 [M], затем получите 1 [M].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/s4.jpg",
        "aspect": 0.7194928684627575,
        "icons": "B"
      },
      {
        "title": "Лорд",
        "general": "Получите 1 [M]. *newline* Восстановите 1 ваш отряд.",
        "unit": "Воин/Жнец/Бессмертный: Получите 1 [B] или 1 [S] за каждый ваш [M].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/s5.jpg",
        "aspect": 0.7194928684627575,
        "icons": ""
      }
    ],
    [
      {
        "title": "Рой Карноптеков",
        "general": "Получите 1 [D]. *newline* Бесплатно разместите 1 жетон подкрепления в эту область.",
        "unit": "",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t0_1.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BM"
      },
      {
        "title": "Разрушители",
        "general": "Потратьте 1 [S] или 1 [M], чтобы получить 2 (B).",
        "unit": "Бессмертный/Жнец: Если у вашего противника есть хотя бы 1 деморализованный отряд, то получите 2 (B).",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t0_2.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BBM"
      },
      {
        "title": "Лич Страж",
        "general": "Деморализуйте 1 ваш отряд, затем ваш противник должен выбрать и деморализовать 1 свой отряд.",
        "unit": "Бессмертный/Жнец: Если у вашего противника есть хотя бы 1 деморализованный отряд, то получите 2 (S).",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t0_3.jpg",
        "aspect": 0.7194928684627575,
        "icons": "SSM"
      },
      {
        "title": "Владыка",
        "general": "Восстановите 1 ваш отряд. *newline* Перебросьте до 2 ваших кубов.",
        "unit": "",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t0_4.jpg",
        "aspect": 0.7194928684627575,
        "icons": "MMM"
      }
    ],
    [
      {
        "title": "Фаланга Монолитов",
        "general": "Если вы не получили урон в этом раунде битвы, то противник должен выбрать и отступить одним из своих отрядов.",
        "unit": "Монолит/Корабль-Гробница: Получите 3 (S).",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t2_1.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BBS"
      },
      {
        "title": "Фаланга Судного Дня",
        "general": "Ваш противник теряет 1 [S].",
        "unit": "Монолит/Корабль-Гробница: Любой отряд противника, деморализованный во время шага нанесения повреждений в этом раунде битвы, - уничтожается. Ваш противник может избежать этого эффекта, если потратит 1 [S].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t2_2.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BBB"
      },
      {
        "title": "Триарх Преторианец",
        "general": "Восстановите 1 ваш деморализованный отряд или бесплатно разместите 1 жетон подкрепления в эту область.",
        "unit": "Воин/Жнец: За каждого недеморализованного Воина или Жнеца вы можете потратить 1 куб, чтобы получить 1 [B], 1 [S] или 1 [M].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t2_3.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BSM"
      }
    ],
    [
      {
        "title": "Мистификатор",
        "general": "Разыграйте верхнюю карту боевой колоды. Не применяйте её способности, но получите её боевые значки до конца этой битвы.",
        "unit": "Ктан: Возьмите вашего Ктана и разместите его в любом дружественном мире.",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t3_1.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BSMM"
      },
      {
        "title": "Несущий Ночь",
        "general": "Выберите и уничтожьте 1 отряд с командным уровнем 0 или получите 3 (B).",
        "unit": "Ктан/Корабль-Гробница: Выберите и уничтожьте 1 отряд с командным уровнем 0-1.",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/combat/t3_2.jpg",
        "aspect": 0.7194928684627575,
        "icons": "BBS"
      }
    ]
  ],
  "ordersText": [
    {
      "title": "Врата Вечности",
      "general": "После перемещения своих отрядов можете взять любое количество своих отрядов командного уровня 0-1 из 1 дружественного мира с постройкой и разместить их в любом мире активной системы, содержащем недеморализованный Монолит. *newline* ОДИН РАЗ ЗА РАУНД.",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/orders/o_1.jpg",
      "aspect": 0.7056910569105691
    },
    {
      "title": "Загробные Миры",
      "general": "После выполнения этого приказа, если вы купили хотя бы 1 отряд или постройку, то вы можете купить 1 бастион и разместить его в дружественном или неконтролируемом мире в активной системе или соседней системе. *newline* ОДИН РАЗ ЗА РАУНД.",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/orders/o_2.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Коронный Мир",
      "general": "Во время выполнения этого приказа вы можете считать все ваши города в активной системе фабриками. *newline* ОДИН РАЗ ЗА РАУНД.",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/orders/o_3.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Протоколы Оживления",
      "general": "После раскрытия этого приказа вы можете восстановить все ваши отряды в активной системе и все ваши наземные отряды во всех других системах. *newline* ОДИН РАЗ ЗА РАУНД.",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/orders/o_4.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Рейд Жнецов",
      "general": "Во время выполнения этого орбитального удара получите 1 [D] и, вы можете выбрать 1 отряд вашего противника с командным уровнем 0. Во время этого орбитального удара этот отряд получает повреждения первым. *newline* ОДИН РАЗ ЗА РАУНД.",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/orders/o_5.jpg",
      "aspect": 0.7051482059282371
    }
  ],
  "eventsText": [
    {
      "title": "Косы Рока",
      "general": "Разместите эту карту в своей игровой зоне и сбросьте все ваши прочие планы. *newpara* В начале любого раунда битвы вы можете сбросить эту карту, чтобы деморализовать до 2 ваших отрядов. За каждый деморализованный отряд ваш противник должен уничтожить 1 жетон подкрепления.",
      "type": "ПЛАН",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_1.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Безжалостная Атака",
      "general": "Разместите эту карту в своей игровой зоне и сбросьте все ваши прочие планы. *newpara* В начале любого раунда битвы вы можете сбросить эту карту, чтобы повторить шаг нанесения повреждений в этом раунде битвы.",
      "type": "ПЛАН",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_2.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Смертоуказатели",
      "general": "Разместите эту карту в своей игровой зоне и сбросьте все ваши прочие планы. *newpara* В начале любого раунда битвы вы можете сбросить эту карту, чтобы деморализовать 1 отряд вашего противника с командным уровнем 0-1.",
      "type": "ПЛАН",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_3.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Орикан Предсказатель",
      "general": "Разместите эту карту в своей игровой зоне и сбросьте все ваши прочие планы. *newpara* В начале любого раунда битвы вы можете сбросить эту карту, чтобы взять до 2 боевых карт, а затем сбросить такое же количество боевых карт из вашей руки.",
      "type": "ПЛАН",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_4.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Пробуждение Ктана",
      "general": "Разместите эту карту в своей игровой зоне и сбросьте все ваши прочие планы. *newpara* В начале любого раунда битвы вы можете сбросить эту карту, чтобы и вы, и ваш противник получили по 3 дополнительного урона во время шага нанесения повреждений.",
      "type": "ПЛАН",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_5.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Сфера Воскрешения",
      "general": "Разместите эту карту в своей игровой зоне и сбросьте все ваши прочие планы. *newpara* В любое время битвы, когда 1 ваш отряд с командным уровнем 0-1 был деморализован или уничтожен, вы можете сбросить эту карту, чтобы взять и вернуть этот отряд недеморализованным в эту область в конце шага нанесения повреждений.",
      "type": "ПЛАН",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_6.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Раскрытие Катакомб",
      "general": "Купите постройку и разместите ее в любом дружественном мире, если он еще не содержит постройку.",
      "type": "ТАКТИКА",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_7.jpg",
      "aspect": 0.7051482059282371
    },
    {
      "title": "Криптеки",
      "general": "Купите 1 боевое улучшение.",
      "type": "ТАКТИКА",
      "source": "https://github.com/MolonLabem/Forbidden_Star/blob/7a9a58bf2284863250f7d4284e292a7c18315a4e/page/factions/gif/necron/events/e_8.jpg",
      "aspect": 0.7051482059282371
    }
  ],
