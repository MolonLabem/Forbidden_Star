  "combatText": [
    [
      {
        "title": "Засада",
        "general": "Получите 2 (B).",
        "unit": "Разведчик/Ударный Крейсер: Любой отряд противника, деморализованный в этом раунде битвы, - уничтожается. Ваш противник может избежать этого уничтожения, если потратит 1 [M].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/28ab2c341b006842924d505c2ec2206f94a754f7/page/factions/base/spacemarines/combat/s1.jpg",
        "icons": "B",
        "aspect": 0.7194928684627575
      },
      {
        "title": "Разведка",
        "general": "Если вы атакуете, то посмотрите выбранную боевую карту противника. *newline* Получите 2 (B) или 2 (S).",
        "unit": "Разведчик/Ударный Крейсер: Потратьте 1 [M], чтобы отступить 1 вашим отрядом.",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/28ab2c341b006842924d505c2ec2206f94a754f7/page/factions/base/spacemarines/combat/s2.jpg",
        "icons": "S",
        "aspect": 0.7194928684627575
      },
      {
        "title": "Ярость Ультрамара",
        "general": "Ваш противник должен перебросить 1 [S]. Затем вы можете перебросить 1 [S].",
        "unit": "Космодесантник/Ударный Крейсер: Вынудите вашего противника потерять 1 [S] или 2 (S).",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/28ab2c341b006842924d505c2ec2206f94a754f7/page/factions/base/spacemarines/combat/s3.jpg",
        "icons": "B",
        "aspect": 0.7194928684627575
      },
      {
        "title": "Благословенная Броня",
        "general": "Получите 2 (S).",
        "unit": "Бастион/Космодесантник/Ударный Крейсер: Переверните до 2 ваших кубов на [S].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/28ab2c341b006842924d505c2ec2206f94a754f7/page/factions/base/spacemarines/combat/s4.jpg",
        "icons": "S",
        "aspect": 0.7194928684627575
      },
      {
        "title": "Вера в Императора",
        "general": "Получите 1 [D].",
        "unit": "Разведчик/Космодесантник/Ударный Крейсер: Восстановите 1 ваш отряд или получите 1 [M].",
        "source": "https://github.com/MolonLabem/Forbidden_Star/blob/28ab2c341b006842924d505c2ec2206f94a754f7/page/factions/base/spacemarines/combat/s5.jpg",
        "icons": "M",
        "aspect": 0.7194928684627575
      }
